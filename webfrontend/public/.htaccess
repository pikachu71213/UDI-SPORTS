RewriteEngine On

# Canonical redirect for legacy route
RewriteRule ^Contribute-now/?$ /donate-now [R=301,L]

# Serve existing files/folders directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for deep routes
RewriteRule ^ index.html [L]
